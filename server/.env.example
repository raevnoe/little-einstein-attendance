# Copy this file to server/.env and fill in real values.
# server/.env is git-ignored. NEVER commit real secrets.
# Put REAL values only in server/.env - this example file is committed to Git.

# --- Server (Phase 1) ---
NODE_ENV=development
PORT=5000
# Comma-separated list of allowed frontend origins (CORS)
CLIENT_ORIGIN=http://localhost:5173
# IANA time zone that defines the school day for Daily Attendance (Phase 6).
SCHOOL_TIME_ZONE=Asia/Manila

# --- Firebase Admin SDK (Phase 2) --- backend only, SECRET
# Firebase Console > Project settings > Service accounts > Generate new private key.
# Copy project_id, client_email and private_key from the downloaded JSON, then
# DELETE the JSON file (or keep it outside this project). Never commit it.
# Keep the private key on ONE line, in double quotes, with literal \n sequences.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"

# Local testing only: point the Admin SDK at the Firebase Auth emulator
# (e.g. 127.0.0.1:9099). Leave empty to use the real Firebase project.
FIREBASE_AUTH_EMULATOR_HOST=

# --- Firebase Storage (later phase) ---
# FIREBASE_STORAGE_BUCKET=

# --- SMS provider (Phase 8) --- backend only
# iprog   = send real SMS through IPROG SMS (default when unset).
# philsms = legacy PhilSMS provider (kept, not in use).
# mock    = log instead of sending (development/tests; refused when NODE_ENV=production).
# Keep mock during normal development so no SMS credits are used. Automated tests always use mock.
SMS_PROVIDER=mock

# --- IPROG SMS --- backend only, SECRET
# API token from your IPROG SMS account. Put the REAL token only in server/.env.
# NEVER in client/.env, never in a VITE_* variable, never in Git.
IPROG_SMS_API_TOKEN=

# --- PhilSMS (legacy, not in use) --- backend only, SECRET
PHILSMS_API_TOKEN=
# Approved sender ID: letters/numbers only, max 11 characters.
PHILSMS_SENDER_ID=
