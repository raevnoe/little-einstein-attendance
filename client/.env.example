# Copy this file to client/.env and adjust as needed. client/.env is git-ignored.
# WARNING: every VITE_* variable is bundled into the browser and is PUBLIC.
# Never put Firebase Admin credentials, the IPROG SMS API token, or other secrets here.
# Put REAL values only in client/.env - this example file is committed to Git.

# Base URL of the Express API. Keep "/api" in development (Vite proxies it).
VITE_API_BASE_URL=/api

# Dev-only: where the Vite dev server forwards /api requests (not bundled).
DEV_API_PROXY_TARGET=http://localhost:5000

# --- Firebase Web SDK config (Phase 2) ---
# Firebase Console > Project settings > General > Your apps > Web app > SDK config.
# These are public identifiers, not secrets. Security comes from the backend
# token checks and Firestore rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Local testing only: use the Firebase Auth emulator instead of the real project.
# Must match FIREBASE_AUTH_EMULATOR_HOST in server/.env. Leave empty for real Firebase.
VITE_FIREBASE_AUTH_EMULATOR_HOST=
