rules_version = '2';

// The web app never reads or writes Firestore directly: every request goes
// through the Express API, which uses the Admin SDK (Admin SDK bypasses rules).
// Deny all direct client access so the public web config can't be used to
// read or modify school data.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
